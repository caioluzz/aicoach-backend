# Copie este arquivo para .env na mesma pasta do pom.xml. O Spring Boot e o
# Docker Compose carregam esse arquivo local, que permanece ignorado pelo Git.
DB_PASSWORD=replace-with-local-database-password
GARMIN_ENCRYPTION_KEY=replace-with-base64-encoded-aes-key

# Opcionais
DB_USERNAME=root
DB_URL=jdbc:mysql://localhost:3306/ai_coach_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
GARMIN_BOT_URL=http://localhost:8000
SERVER_PORT=8080
GARMIN_SYNC_FIXED_DELAY_MS=7200000
GARMIN_SYNC_INITIAL_DELAY_MS=7200000
GARMIN_SYNC_DISCOVERY_LIMIT=100
GARMIN_SYNC_RECOVERY_WINDOW_HOURS=24
GARMIN_SYNC_MAX_ATTEMPTS=3
GARMIN_SYNC_RETRY_DELAY_MS=500
GARMIN_SYNC_CONNECT_TIMEOUT_MS=3000
GARMIN_SYNC_READ_TIMEOUT_MS=60000
GARMIN_ADAPTER_API_KEY=replace-with-shared-local-secret
GARMIN_DELIVERY_MAX_ATTEMPTS=3
GARMIN_DELIVERY_RETRY_DELAY_MS=200
GARMIN_DELIVERY_CONNECT_TIMEOUT_MS=3000
GARMIN_DELIVERY_READ_TIMEOUT_MS=30000

# Plano geral assistido pela OpenAI
# Opcional no primeiro boot: também pode ser cadastrada depois em Configurações.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL_PLANNER=gpt-5-mini
OPENAI_MODEL_WEEKLY_PLANNER=gpt-5-mini
OPENAI_MODEL_ACTIVITY_REVIEW=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_WEEKLY_MAX_OUTPUT_TOKENS=12000
OPENAI_ACTIVITY_REVIEW_MAX_OUTPUT_TOKENS=2500
OPENAI_ACTIVITY_REVIEW_MAX_INSPECTIONS=4
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

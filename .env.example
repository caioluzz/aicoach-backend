# Copie os nomes para variáveis de ambiente locais. Não versionar .env real.
DB_PASSWORD=replace-with-local-database-password
GARMIN_ENCRYPTION_KEY=replace-with-base64-encoded-aes-key

# Opcionais
DB_USERNAME=root
DB_URL=jdbc:mysql://localhost:3306/ai_coach_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
GARMIN_BOT_URL=http://localhost:8000
SERVER_PORT=8080
GARMIN_SYNC_INITIAL_DELAY_MS=60000

# Plano geral assistido pela OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL_PLANNER=gpt-5-mini
OPENAI_MODEL_WEEKLY_PLANNER=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_WEEKLY_MAX_OUTPUT_TOKENS=12000
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
